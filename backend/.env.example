# Server
PORT=3000
NODE_ENV=development

# CORS - origin allowed to call this API
FRONTEND_URL=http://localhost:5173

# PostgreSQL (matches k8s/manifests/02-postgres/secret.yaml in the deployed cluster)
DATABASE_URL=postgresql://cloud_user:changeme@localhost:5432/cloud_platform

# Kubernetes (added in Phase 3 - instance provisioning)
K8S_NAMESPACE=cloud-platform
INSTANCE_TTL_SECONDS=600

# Auth (added in Phase 2)
JWT_SECRET=changeme-generate-a-real-secret
JWT_EXPIRES_IN=30m
